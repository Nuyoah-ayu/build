-	const struct rtw89_mfw_info *mfw_info;
+	const struct rtw89_mfw_info *mfw_info = NULL, *candidate;
 	int i;
 
 	if (mfw_hdr->sig != RTW89_MFW_SIG) {
@@ -476,14 +476,19 @@
 	}
 
 	for (i = 0; i < mfw_hdr->fw_nr; i++) {
-		mfw_info = &mfw_hdr->info[i];
-		if (mfw_info->type == type) {
-			if (mfw_info->cv == rtwdev->hal.cv && !mfw_info->mp)
-				goto found;
-			if (type == RTW89_FW_LOGFMT)
-				goto found;
+		candidate = &mfw_hdr->info[i];
+		if (candidate->type != type)
+			continue;
+		if (type == RTW89_FW_LOGFMT) {
+			mfw_info = candidate;
+			goto found;
 		}
-	}
+		if (candidate->cv <= rtwdev->hal.cv && !candidate->mp &&
+		    (!mfw_info || mfw_info->cv < candidate->cv))
+			mfw_info = candidate;
+	}
+	if (mfw_info)
+		goto found;
 
 	if (!nowarn)
 		rtw89_err(rtwdev, "no suitable firmware found\n");
@@ -606,10 +611,12 @@
 	struct rtw89_hal *hal = &rtwdev->hal;
 	struct rtw89_fw_suit *fw_suit;
 
-	if (hal->cv != elm->u.bbmcu.cv)
