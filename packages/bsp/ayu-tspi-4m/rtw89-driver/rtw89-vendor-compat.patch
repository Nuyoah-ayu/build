Backport firmware cut fallback, HE capability assignment, and PPDU GI matching.

--- a/fw.c
+++ b/fw.c
@@ -462,7 +462,7 @@
 	const u8 *mfw = firmware->data;
 	u32 mfw_len = firmware->size;
