# packages/blobs/asound.state/asound.state.tspi-4m

# Minimal runtime state for the TSPI-4M ES8388 card
# (label "rockchip,es8388-codec", simple-audio-card on i2s0_8ch).
#
# Mux and switch state is left to DAPM: the widget graph in the DTS
# auto-selects the correct input source and enables the output PGA
# widgets when a stream is opened. Only the volume registers need a
# non-zero default, because they start at 0 (fully muted).
#
# Ranges and TLV values are taken from sound/soc/codecs/es8328.c.

state.rockchipes8388 {
	control.1 {
		iface MIXER
		name 'PCM Volume'
		value.0 192
		value.1 192
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 192'
			dbmin -9600
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.2 {
		iface MIXER
		name 'Output 1 Playback Volume'
		value.0 27
		value.1 27
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 36'
			dbmin -3000
			dbmax 600
			dbvalue.0 -300
			dbvalue.1 -300
		}
	}
	control.3 {
		iface MIXER
		name 'Output 2 Playback Volume'
		value.0 27
		value.1 27
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 36'
			dbmin -3000
			dbmax 600
			dbvalue.0 -300
			dbvalue.1 -300
		}
	}
	control.4 {
		iface MIXER
		name 'Capture Digital Volume'
		value.0 173
		value.1 173
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 192'
			dbmin -9600
			dbmax 0
			dbvalue.0 -950
			dbvalue.1 -950
		}
	}
	control.5 {
		iface MIXER
		name 'Mic PGA Volume'
		value.0 8
		value.1 8
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 8'
			dbmin 0
			dbmax 2400
			dbvalue.0 2400
			dbvalue.1 2400
		}
	}
}
