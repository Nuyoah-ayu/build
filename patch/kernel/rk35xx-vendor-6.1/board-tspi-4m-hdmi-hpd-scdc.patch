Subject: [PATCH] drm: dw-hdmi-qp: check sink SCDC support during HPD recovery

Use the setup capability check before writing SCDC during HPD recovery.
Keep the local scrambler disabled for low TMDS rates.

--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi-qp.c
@@ -3268,7 +3268,7 @@
 
 	if (enable && hdmi->disabled) {
-		if (!is_hdmi14) {
+		if (!is_hdmi14 && dw_hdmi_support_scdc(hdmi, &hdmi->connector.display_info)) {
 			drm_scdc_set_high_tmds_clock_ratio(hdmi->ddc, 1);
 			drm_scdc_set_scrambling(hdmi->ddc, 1);
 			hdmi_writel(hdmi, 1, SCRAMB_CONFIG0);
 			/* Wait for resuming transmission of TMDS clock and data */
@@ -3275,7 +3275,9 @@
 			msleep(100);
 		} else {
-			drm_scdc_set_high_tmds_clock_ratio(hdmi->ddc, 0);
-			drm_scdc_set_scrambling(hdmi->ddc, 0);
+			if (dw_hdmi_support_scdc(hdmi, &hdmi->connector.display_info)) {
+				drm_scdc_set_high_tmds_clock_ratio(hdmi->ddc, 0);
+				drm_scdc_set_scrambling(hdmi->ddc, 0);
+			}
 			hdmi_writel(hdmi, 0, SCRAMB_CONFIG0);
 		}
 
